      }
     ]
    },
    {
     "tenh:predicate": "tenh:documented_in",
     "tenh:object": {
      "@id": "tenh:doc/by-drs-17-554"
     },
     "tenh:start": "2014-02-04",
     "tenh:marker": "primary",
     "tenh:evidence": [

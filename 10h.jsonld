     "tenh:predicate": "tenh:led_to",
     "tenh:object": {
      "@id": "tenh:procedure/by-10h-law"
     },
     "tenh:marker": "primary",
     "tenh:rationale": "The Bavarian cabinet decided on 04.02.2014 to use the clause with 10H and approved the draft on 08.04.2014.",
     "tenh:evidence": [
      {
       "tenh:document": {
        "@id": "tenh:doc/by-drs-17-2350"

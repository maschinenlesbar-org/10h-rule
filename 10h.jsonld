   "@id": "tenh:event/2014-02-04-the-bavarian-cabinet-decides-to",
   "@type": "schema:Event",
   "schema:name": "The Bavarian cabinet decides to use the clause \"unverzüglich\"; the new rule \"soll grundsätzlich einen Mindestabstand von 10 H … …",
   "schema:url": "https://maschinenlesbar.org/10h-rule/e/event/2014-02-04-the-bavarian-cabinet-decides-to/",
   "tenh:statements": [
    {
     "tenh:predicate": "tenh:documented_in",
